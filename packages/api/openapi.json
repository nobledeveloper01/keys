  "info": {
    "title": "Keys",
    "description": "Renting in Nigeria without paying a stranger for a flat that was already let.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "reviewer": {
        "type": "apiKey",
        "in": "header",
        "name": "x-reviewer-token"
      }
    },
    "schemas": {
      "LookupResponse": {
        "type": "object",
        "properties": {
          "checked": {
            "type": "boolean",
            "description": "Always true. Present so that \"we checked and found nothing\" cannot be confused with \"the request failed\"."
          },
          "upheldReports": {
            "type": "number",
            "description": "Reports a person reviewed and upheld. Never a count of submissions."
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "fake_listing",
                "inspection_fee_scam",
                "property_already_let",
                "impersonation",
                "undisclosed_fees",
                "no_show"
              ]
            }
          },
          "mostRecent": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "everyReportHadRightOfReply": {
            "type": "boolean",
            "description": "False if any published report went unanswered within its reply window."
          },
          "meaning": {
            "type": "string",
            "description": "Plain words for the reader. Zero upheld is not a clean bill of health."
          }
        },
        "required": [
          "checked",
          "upheldReports",
          "categories",
          "mostRecent",
          "everyReportHadRightOfReply",
          "meaning"
        ]
      },
      "TransparencyResponse": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "received": {
            "type": "number",
            "description": "Reports submitted in the window."
          },
          "upheld": {
            "type": "number"
          },
          "notUpheld": {
            "type": "number",
            "description": "Dismissed or found to have insufficient evidence. The number nobody in this market publishes."
          },
          "awaitingDecision": {
            "type": "number"
          },
          "medianDaysToDecision": {
            "type": "number",
            "nullable": true,
            "description": "Median, not mean — one stalled case must not hide the typical wait."
          },
          "oldestAwaitingDays": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "since",
          "received",
          "upheld",
          "notUpheld",
          "awaitingDecision",
          "medianDaysToDecision",
          "oldestAwaitingDays"
        ]
      },
      "SubmitReportBody": {
        "type": "object",
        "properties": {
          "reportedPhone": {
            "type": "string",
            "example": "+2348012345678"
          },
          "category": {
            "type": "string",
            "enum": [
              "fake_listing",
              "inspection_fee_scam",
              "property_already_let",
              "impersonation",
              "undisclosed_fees",
              "no_show"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "A report nobody can assess cannot be upheld."
          },
          "evidenceKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "reportedPhone",
          "category",
          "description"
        ]
      },
      "ReportAcceptedResponse": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "under_review",
              "awaiting_reply",
              "upheld",
              "not_upheld",
              "insufficient_evidence",
              "resolved",
              "expired"
            ]
          },
          "replyDeadlineAt": {
            "type": "string",
            "format": "date-time"
          },
          "whatHappensNext": {
            "type": "string"
          }
        },
        "required": [
          "received",
          "status",
          "replyDeadlineAt",
          "whatHappensNext"
        ]
      },
      "ReplyView": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "fake_listing",
              "inspection_fee_scam",
              "property_already_let",
              "impersonation",
              "undisclosed_fees",
              "no_show"
            ]
          },
          "description": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "replyBy": {
            "type": "string",
            "format": "date-time"
          },
          "alreadyReplied": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "category",
          "description",
          "submittedAt",
          "replyBy",
          "alreadyReplied",
          "note"
        ]
      },
      "SubmitReplyBody": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The token texted to the number that was reported."
          },
          "reply": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "token",
          "reply"
        ]
      },
      "ReviewView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "under_review",
              "awaiting_reply",
              "upheld",
              "not_upheld",
              "insufficient_evidence",
              "resolved",
              "expired"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "fake_listing",
              "inspection_fee_scam",
              "property_already_let",
              "impersonation",
              "undisclosed_fees",
              "no_show"
            ]
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          },
          "replyDeadlineAt": {
            "type": "string",
            "format": "date-time"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "evidenceCount": {
            "type": "number"
          },
          "hasReply": {
            "type": "boolean"
          },
          "reply": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "status",
          "category",
          "submittedAt",
          "replyDeadlineAt",
          "publishedAt",
          "description",
          "evidenceCount",
          "hasReply",
          "reply"
        ]
      },
      "ReviewerTally": {
        "type": "object",
        "properties": {
          "reviewer": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "upheld",
              "not_upheld",
              "insufficient_evidence",
              "evidence_recorded"
            ]
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "reviewer",
          "action",
          "count"
        ]
      },
      "ThroughputResponse": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time"
          },
          "decisions": {
            "description": "What each reviewer decided. Named, because \"a reviewer\" is not an answer to \"who decided this\".",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewerTally"
            }
          },
          "waiting": {
            "type": "number",
            "description": "Reports waiting. This is the constraint on how fast Keys can open a city."
          },
          "oldestWaitingSince": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "since",
          "decisions",
          "waiting",
          "oldestWaitingSince"
        ]
      },
      "EvidenceBody": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "minLength": 20,
            "description": "What the evidence was. A reviewer auditing this later reads exactly this."
          },
          "source": {
            "type": "string",
            "minLength": 3,
            "example": "emailed screenshots",
            "description": "How it reached you. Phase 1 has no upload; phase 3 replaces this with files."
          }
        },
        "required": [
          "note",
          "source"
        ]
      },
      "DecisionBody": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "upheld",
              "not_upheld",
              "insufficient_evidence"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 20,
            "description": "Why. Mandatory: this is the audit record for a public claim about a named person, and somebody may have to answer for it a year from now."
          }
        },
        "required": [
          "decision",
          "reasoning"
        ]
      },
      "DecisionResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "submitted",
              "under_review",
              "awaiting_reply",
              "upheld",
              "not_upheld",
              "insufficient_evidence",
              "resolved",
              "expired"
            ]
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "nowVisiblePublicly": {
            "type": "boolean",
            "description": "Said out loud so a reviewer knows what they just did in public."
          }
        },
        "required": [
          "id",
          "status",
          "publishedAt",
          "nowVisiblePublicly"
        ]
      },
      "SignUpBody": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "example": "Chinedu Okafor"
          },
          "phone": {
            "type": "string",
            "example": "+2348012345678"
          }
        },
        "required": [
          "displayName",
          "phone"
        ]
      },
      "SignUpResponse": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "token": {
            "type": "string",
            "description": "Shown once. Keys does not store it, only its digest."
          }
        },
        "required": [
          "agentId",
          "token"
        ]
      },
      "AgentProfileResponse": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "unverified",
              "identity",
              "authority",
              "established"
            ],
            "description": "Computed from evidence on every read. Not stored."
          },
          "meaning": {
            "type": "string",
            "description": "What was actually checked, in words a tenant could go and verify."
          },
          "confirmedProperties": {
            "type": "number",
            "description": "Properties a landlord has confirmed they may let."
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "upheldReports": {
            "type": "number",
            "description": "Upheld scam reports against this agent. Zero is not a clean bill of health."
          }
        },
        "required": [
          "agentId",
          "displayName",
          "tier",
          "meaning",
          "confirmedProperties",
          "joinedAt",
          "upheldReports"
        ]
      },
      "AuthorityRequestBody": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string",
            "description": "The property this authority would cover."
          },
          "landlordPhone": {
            "type": "string",
            "example": "+2348012345678",
            "description": "The landlord's number. Not the agent's."
          }
        },
        "required": [
          "propertyId",
          "landlordPhone"
        ]
      },
      "ChallengeOpenedResponse": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "description": "Given to the landlord, not to the agent."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "delivered": {
            "type": "boolean",
            "description": "Whether the text could actually be sent yet."
          },
          "whatHappensNext": {
            "type": "string"
          }
        },
        "required": [
          "challengeId",
          "expiresAt",
          "delivered",
          "whatHappensNext"
        ]
      },
      "CreateListingBody": {
        "type": "object",
        "properties": {
          "propertyId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "2 bedroom flat, Yaba"
          }
        },
        "required": [
          "propertyId",
          "title"
        ]
      },
      "StillNeeded": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "enum": [
              "agent_identity",
              "landlord_authority",
              "capture_on_site",
              "walkthrough_video",
              "not_a_known_duplicate",
              "recently_confirmed",
              "nothing_upheld"
            ]
          },
          "whatToDo": {
            "type": "string",
            "description": "A sentence with a next action in it, not a failure notice."
          }
        },
        "required": [
          "condition",
          "whatToDo"
        ]
      },
      "ListingResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "propertyId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "stillNeeded": {
            "description": "Which of the seven Verified conditions are unmet, and what to do. Empty means Verified.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StillNeeded"
            }
          }
        },
        "required": [
          "id",
          "propertyId",
          "title",
          "publishedAt",
          "stillNeeded"
        ]
      },
      "AnswerChallengeBody": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "049217",
            "description": "The six digits from the text."
          }
        },
        "required": [
          "challengeId",
          "code"
        ]
      },
      "ChallengeAnsweredResponse": {
        "type": "object",
        "properties": {
          "confirmed": {
            "type": "boolean"
          },
          "withdrawn": {
            "type": "boolean",
            "description": "True when the code withdrew an authority rather than granting one."
          },
          "unpublishedListings": {
            "description": "Listings that went dark as a result. Empty on a grant.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meaning": {
            "type": "string"
          }
        },
        "required": [
          "confirmed",
          "withdrawn",
          "unpublishedListings",
          "meaning"
        ]
      },
      "IdentityCheckBody": {
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string",
            "description": "The KYC vendor that ran the liveness and document check."
          },
          "reference": {
            "type": "string",
            "description": "The vendor's own reference for the check, so it can be re-pulled."
          },
          "agentId": {
            "type": "string",
            "description": "The agent the vendor checked."
          }
        },
        "required": [
          "vendor",
          "reference",
          "agentId"
        ]
      },
      "AttestationView": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "identity",
              "authority",
              "standing"
            ]
          },
          "attestor": {
            "type": "string",
            "description": "Who attested. Never a landlord's phone number."
          },
          "propertyId": {
            "type": "string",
            "nullable": true
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "live": {
            "type": "boolean",
            "description": "False once withdrawn. Withdrawn evidence is kept, not deleted."
          }
        },
        "required": [
          "kind",
          "attestor",
          "propertyId",
          "at",
          "live"
        ]
      },
      "AgentUnderReview": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "unverified",
              "identity",
              "authority",
              "established"
            ]
          },
          "meaning": {
            "type": "string"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          },
          "upheldReports": {
            "type": "number"
          },
          "publishedListings": {
            "type": "number"
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttestationView"
            }
          }
        },
        "required": [
          "agentId",
          "displayName",
          "tier",
          "meaning",
          "joinedAt",
          "upheldReports",
          "publishedListings",
          "evidence"
        ]
      },
      "RegisterDeviceBody": {
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string",
            "description": "The device's P-256 public key, SPKI DER, base64. P-256 because that is what the Secure Enclave holds."
          }
        },
        "required": [
          "publicKey"
        ]
      },
      "CaptureBody": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string"
          },
          "listingId": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the media bytes, lower-case hex."
          },
          "capturedAt": {
            "type": "string",
            "format": "date-time"
          },
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "nonce": {
            "type": "string",
            "description": "Once per capture. A reused one is refused."
          },
          "mockLocation": {
            "type": "boolean",
            "description": "What the OS said about the location. Signed, so it cannot be flipped."
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "video"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "nullable": true
          },
          "signature": {
            "type": "string",
            "description": "ECDSA P-256 over SHA-256 of the canonical claim, DER, base64."
          },
          "pixels": {
            "type": "string",
            "description": "The capture itself: a Keys greyscale grid, base64. Its SHA-256 must be the one inside the signature."
          }
        },
        "required": [
          "deviceId",
          "listingId",
          "sha256",
          "capturedAt",
          "latitude",
          "longitude",
          "nonce",
          "mockLocation",
          "kind",
          "durationSeconds",
          "signature",
          "pixels"
        ]
      },
      "CaptureRefusedResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "refusals": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "unknown_device",
                "not_this_agents_device",
                "bad_signature",
                "bytes_do_not_match",
                "replayed",
                "stale",
                "from_the_future",
                "mock_location"
              ]
            }
          },
          "meaning": {
            "description": "One sentence per refusal, written for the agent.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duplicates": {
            "type": "string",
            "enum": [
              "blocked",
              "allowed",
              "pending"
            ],
            "description": "Never \"blocked\" here. A match opens a review; a person decides."
          },
          "looksLikeListings": {
            "description": "Listings this image resembles.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "accepted",
          "refusals",
          "meaning",
          "duplicates",
          "looksLikeListings"
        ]
      },
      "DuplicatePairView": {
        "type": "object",
        "properties": {
          "listingId": {
            "type": "string",
            "description": "The listing that uploaded the picture second."
          },
          "matchedListingId": {
            "type": "string",
            "description": "The listing that already had it."
          },
          "distance": {
            "type": "number",
            "description": "Differing bits, out of 64. Zero is the same file."
          },
          "firstSeenAt": {
            "type": "string",
            "format": "date-time"
          },
          "meaning": {
            "type": "string",
            "description": "What the distance means, in words a reviewer can act on."
          }
        },
        "required": [
          "listingId",
          "matchedListingId",
          "distance",
          "firstSeenAt",
          "meaning"
        ]
      },
      "DuplicateDecisionBody": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "blocked",
              "allowed"
            ]
          },
          "reasoning": {
            "type": "string",
            "minLength": 20,
            "description": "Mandatory. This is the audit record."
          }
        },
        "required": [
          "decision",
          "reasoning"
        ]
      }
    }
  }
}
